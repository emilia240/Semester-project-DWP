{
  "name": "to-be-human",
  "version": "1.0.0",
  "private": true,
  "description": "To Be Human - build setup for the CSS (Tailwind + daisyUI). The PHP part needs no Node.",
  "scripts": {
    "build": "tailwindcss -i assets-src/input.css -o assets/css/app.css --minify",
    "watch": "tailwindcss -i assets-src/input.css -o assets/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3"
  }
}
